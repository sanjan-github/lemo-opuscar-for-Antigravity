node_modules/
.venv/
.lemo-deps.lock/
__pycache__/
.DS_Store
# Models and large assets (download URLs provided in run instructions)
core/tts/*.onnx
core/tts/*.bin
core/assets/polyhaven/*.hdr
# Intermediate render artifacts
styles/*/demo/out/
styles/*/demo/voices/*.wav
styles/*/demo/music/*.mp3
styles/*/demo/music/*.wav
styles/*/demo/music/*.npy
styles/*/demo/mix.wav
# Final films distributed via GitHub Releases
styles/*/*.mp4
# Additional intermediate files
styles/*/demo/out_*/
styles/*/demo/chk/
styles/*/demo/node_modules
styles/*/demo/assets/*.hdr
styles/*/demo/tts/*.onnx
styles/*/demo/tts/*.bin
styles/*/demo/music.wav
*.log
# Audio shouts input files to track
!styles/game-show/demo/voices/*.wav
styles/*/demo/music/src/

# Internal working files (not public)
/promo/
/batch/
/TODO.md
/STYLES.md
styles/*/HANDOFF.md
# Music stems, mixes, foley: build.sh regenerates them
styles/*/demo/**/stems*/
styles/*/demo/**/music_stems/
styles/*/demo/**/mix*.wav
styles/*/demo/audio/*.wav
core/audio/*.wav
# Large assets distributed via Releases assets bundle (download with sh tools/fetch.sh)
core/audio/instruments/
# Demo fonts are not in git: free (mostly Google Fonts, OFL); credited in each demo
styles/*/demo/fonts/**/*.ttf
styles/*/demo/fonts/**/*.otf
# Release staging / Pages build output
/.release/
/_site/

# Demo folders keep code and CREDITS for agents to read; renders, media and process notes stay local
styles/*/storyboard/
styles/*/demo/TREATMENT.md
styles/*/demo/**/*.wav
styles/*/demo/**/*.mp3
styles/*/demo/**/*.ogg
styles/*/demo/**/*.flac
styles/*/demo/**/*.mp4
styles/*/demo/**/*.woff
styles/*/demo/**/*.woff2
styles/*/demo/**/*.part
styles/*/demo/**/*.gltf
styles/*/demo/**/*.glb
styles/*/demo/**/*.bin
styles/*/demo/**/*.hdr
styles/*/demo/**/*.exr
styles/*/demo/**/*.jpg
styles/*/demo/**/*.jpeg
styles/*/demo/**/*.png
styles/*/demo/**/*.webp
styles/*/demo/**/*.svg
# Stills: only review frames pointed to by docs are committed; others in stills/ are debug frames.
styles/*/demo/stills/*
!styles/*/demo/stills/styleframe.jpg
!styles/*/demo/stills/frame_*.jpg
!styles/*/demo/stills/alt_*.jpg
!styles/*/demo/stills/engine*.jpg
# Illustrative plates a demo's build needs (credited in CREDITS) are committed
!styles/news-package/demo/assets/plates/*.jpg

# User films (agent output)
/films/

# Production logs are internal: keep local
styles/*/PRODUCTION_LOG*
styles/*/demo/PRODUCTION_LOG*

# Promotional materials: keep local
/docs/social/

# Source photos, imagery caches and fonts anywhere in a demo stay local
styles/*/demo/**/*.ttf
styles/*/demo/**/*.otf
styles/*/demo/**/*.tif
styles/*/demo/**/*.tiff
styles/*/demo/**/*.npz
styles/*/demo/assets/raw/
# Downloaded archive sources (footage, scans, PDFs) and edit caches stay local
styles/*/demo/raw/
styles/*/demo/work/
styles/*/demo/**/*.webm
styles/*/demo/**/*.mpeg
styles/*/demo/**/*.ogv
styles/*/demo/**/*.mov
styles/*/demo/**/*.pdf

# ---- Process notes and drafts stay local, anywhere in the repo ----
**/TREATMENT.md
**/PRODUCTION_LOG*
**/HANDOFF*.md
**/NOTES.md
**/PROGRESS*.md
**/TODO*.md
*.bak
*.orig
*~
*_old.*
*_bak.*
*_draft.*
**/tmp/
**/scratch/
# Self-check reports music scripts rewrite on every build
styles/*/demo/music/check.txt
styles/*/demo/music/check.json
styles/*/demo/music/*report*.txt
# Partial outputs and try-out helpers
styles/*/demo/**/*_partial.json
styles/*/demo/**/*_try.py
# Superseded first-round review frames
styles/*/demo/stills/*_v1*
!styles/art-deco/demo/stills/kit.jpg

# Character list generated during font subset steps
styles/isometric-picture-book/demo/tools/chars.txt
